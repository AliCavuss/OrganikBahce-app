<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>

    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,300,400,600,700,800,900" rel="stylesheet" />
    <link href="~/css/sb-admin-2.min.css" rel="stylesheet" />
</head>
<body id="page-top">

    <div id="wrapper">

        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">

            <a class="sidebar-brand d-flex align-items-center justify-content-center"
                   asp-controller="Home" asp-action="Index">
                <div class="sidebar-brand-icon rotate-n-15">
                    <i class="fas fa-leaf"></i>
                </div>
                <div class="sidebar-brand-text mx-3">Admin Panel</div>
            </a>

            <hr class="sidebar-divider my-0" />

            @if (User.Identity!.IsAuthenticated && User.IsInRole("Admin"))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-fw fa-tachometer-alt"></i>
                        <span>Panel</span>
                    </a>
                </li>

                <hr class="sidebar-divider" />

                <div class="sidebar-heading">
                    Kategori İşlemleri
                </div>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Category" asp-action="Create">
                        <i class="fas fa-folder-plus"></i>
                        <span>Kategori Oluştur</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Category" asp-action="List">
                        <i class="fas fa-list"></i>
                        <span>Kategorileri Listele</span>
                    </a>
                </li>

                <hr class="sidebar-divider" />

                <div class="sidebar-heading">
                    Ürün İşlemleri
                </div>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Product" asp-action="List">
                        <i class="fas fa-box"></i>
                        <span>Ürünleri Listele</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Product" asp-action="PassiveList">
                        <i class="fas fa-ban"></i>
                        <span>Pasif Ürünler</span>
                    </a>
                </li>

                <hr class="sidebar-divider" />

                <div class="sidebar-heading">
                    Kullanıcı İşlemleri
                </div>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="User" asp-action="List">
                        <i class="fas fa-users"></i>
                        <span>Kullanıcıları Listele</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="User" asp-action="SellerRequests">
                        <i class="fas fa-user-check"></i>
                        <span>Satıcı Talepleri</span>
                    </a>
                </li>

                <hr class="sidebar-divider" />

                <div class="sidebar-heading">
                    Yorum İşlemleri
                </div>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Comment" asp-action="List">
                        <i class="fas fa-comments"></i>
                        <span>Yorumları Listele</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Comment" asp-action="PendingList">
                        <i class="fas fa-clock"></i>
                        <span>Onay Bekleyen Yorumlar</span>
                    </a>
                </li>
            }

            <hr class="sidebar-divider d-none d-md-block" />

            <div class="text-center d-none d-md-inline">
                <button class="rounded-circle border-0" id="sidebarToggle"></button>
            </div>
        </ul>

        <div id="content-wrapper" class="d-flex flex-column">
            <div id="content">

                @await Html.PartialAsync("_Topbar")

                <div class="container-fluid mt-4">
                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @ViewBag.Message
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    }

                    @if (ViewData["Message"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @ViewData["Message"]
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    }

                    @RenderBody()
                </div>
            </div>

            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>&copy; @DateTime.Now.Year - Organik Bahçe Admin Panel</span>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="logoutModalLabel"
         aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="logoutModalLabel">Çıkış yapmak istiyor musun?</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">
                    Oturumu kapatmak için aşağıdaki çıkış butonuna tıkla.
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Vazgeç</button>
                    <a class="btn btn-primary" asp-controller="Auth" asp-action="Logout">Çıkış Yap</a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/vendor/jquery/jquery.min.js"></script>
    <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/js/sb-admin-2.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>