@model Admin.Mvc.Models.ViewModels.CategoryCreateViewModel

@{
    ViewData["Title"] = "Kategori Oluştur";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Kategori Oluştur</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card shadow mb-4">
    <div class="card-body">

        <form method="post" action="/category/create">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label class="form-label">Kategori Adı</label>
                <input asp-for="Name" class="form-control" placeholder="Örn: Sebze" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Renk (opsiyonel)</label>
                <input asp-for="Color" class="form-control" placeholder="Örn: #28a745 veya green" />
                <span asp-validation-for="Color" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Icon Css Class (opsiyonel)</label>
                <input asp-for="IconCssClass" class="form-control" placeholder="Örn: fa fa-leaf" />
                <span asp-validation-for="IconCssClass" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Kaydet
            </button>

            <a href="/admin" class="btn btn-secondary">
                İptal
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}