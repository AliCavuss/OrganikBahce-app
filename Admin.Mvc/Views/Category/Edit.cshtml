@model Admin.Mvc.Models.ViewModels.CategoryEditViewModel

@{
    ViewData["Title"] = "Kategori Düzenle";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Kategori Bilgileri</h6>
    </div>

    <div class="card-body">

        <div class="alert alert-info">
            Düzenlenen Kategori Id: <strong>@Model.Id</strong>
        </div>

        <form method="post" action="/category/@Model.Id/edit">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label>Kategori Adı</label>
                <input asp-for="Name" class="form-control" placeholder="Örn: Meyveler" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label>Renk (opsiyonel)</label>
                <input asp-for="Color" class="form-control" placeholder="Örn: #28a745 veya green" />
                <span asp-validation-for="Color" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label>Icon Css Class (opsiyonel)</label>
                <input asp-for="IconCssClass" class="form-control" placeholder="Örn: fa fa-leaf" />
                <span asp-validation-for="IconCssClass" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save mr-1"></i> Kaydet
            </button>

            <a class="btn btn-secondary" asp-controller="Home" asp-action="Index">İptal</a>

            <a class="btn btn-danger" href="/category/@Model.Id/delete"
               onclick="return confirm('Bu kategoriyi silmek istediğine emin misin?');">
                <i class="fas fa-trash mr-1"></i> Sil
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}