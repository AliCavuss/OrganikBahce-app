@model OrganikBahce.MVC.Models.ViewModels.ProductCommentCreateViewModel

<h4>Yorum Yap</h4>

<form method="post" action="/product/@ViewBag.ProductId/comment">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label>Yorum</label>
        <textarea asp-for="Text"
                  class="form-control"
                  rows="4"></textarea>
        <span asp-validation-for="Text" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Puan</label>
        <select asp-for="StarCount" class="form-control">
            <option value="">Seçiniz</option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
        </select>
        <span asp-validation-for="StarCount" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        Yorumu Gönder
    </button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}