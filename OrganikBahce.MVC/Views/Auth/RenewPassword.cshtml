@model OrganikBahce.MVC.Models.ViewModels.AuthRenewPasswordViewModel

<form method="post" action="/renew-password">

    <div asp-validation-summary="All" class="text-danger"></div>

    <input asp-for="VerificationCode" type="hidden" value="@ViewBag.VerificationCode" />

    <div class="form-group mb-3">
        <label asp-for="NewPassword"></label>
        <input asp-for="NewPassword" type="password" class="form-control" />
        <span asp-validation-for="NewPassword" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="NewPasswordAgain"></label>
        <input asp-for="NewPasswordAgain" type="password" class="form-control" />
        <span asp-validation-for="NewPasswordAgain" class="text-danger"></span>
    </div>

    <button type="submit" class="site-btn">
        Şifreyi Güncelle
    </button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}