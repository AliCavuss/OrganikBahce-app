@model OrganikBahce.MVC.Models.ViewModels.ProductCreateViewModel

<h1>Ürün Oluşturma</h1>

<form method="post" action="/product" enctype="multipart/form-data">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Details"></label>
        <input asp-for="Details" class="form-control" />
        <span asp-validation-for="Details" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price"></label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId"></label>
        <input asp-for="CategoryId" type="number" class="form-control" />
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StockAmount"></label>
        <input asp-for="StockAmount" type="number" class="form-control" />
        <span asp-validation-for="StockAmount" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ImageFile">Ürün Görseli</label>
        <input asp-for="ImageFile" type="file" class="form-control" />
        <span asp-validation-for="ImageFile" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Kaydet
    </button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}