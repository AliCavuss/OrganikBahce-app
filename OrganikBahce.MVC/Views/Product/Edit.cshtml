@model OrganikBahce.MVC.Models.ViewModels.ProductEditViewModel

<h1>Ürün Düzenleme</h1>

<form method="post" action="/product/@Model.Id/edit">

    <div asp-validation-summary="All" class="text-danger"></div>

    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Details"></label>
        <input asp-for="Details" class="form-control" />
        <span asp-validation-for="Details" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price"></label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId"></label>
        <input asp-for="CategoryId" type="number" class="form-control" />
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SellerId"></label>
        <input asp-for="SellerId" type="number" class="form-control" />
        <span asp-validation-for="SellerId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StockAmount"></label>
        <input asp-for="StockAmount" type="number" class="form-control" />
        <span asp-validation-for="StockAmount" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-warning">
        Güncelle
    </button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}